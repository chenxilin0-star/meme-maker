/* 我的页面 */
.profile-page {
  padding-bottom: 48rpx;
}

/* 用户卡片 */
.user-card {
  padding: 40rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: none;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg);
}

.user-meta {
  flex: 1;
}

.nickname-input {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  height: 56rpx;
  min-height: 56rpx;
}

.user-tip {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 统计 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--border);
}

/* 作品列表 */
.memes-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.meme-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
}

.meme-image {
  width: 100%;
  height: 100%;
}

.meme-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 8rpx;
  transition: background 0.2s;
}

.meme-item:active .meme-overlay {
  background: rgba(0, 0, 0, 0.3);
}

.delete-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  font-size: 24rpx;
  color: #E53935;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.empty-subtext {
  font-size: 26rpx;
  color: var(--text-light);
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

/* 设置 */
.settings-card {
  padding: 24rpx 32rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: var(--text);
}

.setting-arrow {
  font-size: 36rpx;
  color: var(--text-light);
}