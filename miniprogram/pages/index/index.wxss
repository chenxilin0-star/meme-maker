/* 首页样式 */

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: 48rpx;
  padding: 0 24rpx;
  height: 80rpx;
  box-shadow: var(--shadow);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
}

.search-btn {
  background: var(--primary);
  color: #fff;
  border-radius: 48rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 32rpx;
  margin: 0;
}

.search-btn::after {
  border: none;
}

/* 热门文案 */
.hot-texts-card {
  padding-bottom: 16rpx;
}

.hot-texts-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hot-text-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.hot-text-item:last-child {
  border-bottom: none;
}

.hot-text-rank {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--bg);
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.hot-text-item:nth-child(1) .hot-text-rank {
  background: #FF6B6B;
  color: #fff;
}

.hot-text-item:nth-child(2) .hot-text-rank {
  background: #FF8C42;
  color: #fff;
}

.hot-text-item:nth-child(3) .hot-text-rank {
  background: #FFE66D;
  color: var(--text);
}

.hot-text-content {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
}

.hot-text-tag {
  font-size: 22rpx;
  color: var(--text-light);
  background: var(--bg);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.refresh-bar {
  text-align: center;
  padding-top: 16rpx;
  margin-top: 8rpx;
  border-top: 2rpx solid var(--border);
}

.refresh-text {
  font-size: 26rpx;
  color: var(--primary);
}

/* 快速制作 */
.quick-make {
  margin-bottom: 24rpx;
}

.quick-make .btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 36rpx;
}

/* 模板区域 */
.templates-card {
  padding-bottom: 24rpx;
}

.category-scroll {
  margin-bottom: 24rpx;
}

.category-list {
  display: flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.category-item {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg);
  white-space: nowrap;
  transition: all 0.2s;
}

.category-item.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.templates-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.template-item {
  background: var(--bg);
  border-radius: 20rpx;
  overflow: hidden;
  padding: 16rpx;
}

.template-preview {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 12rpx;
}

.template-emoji {
  font-size: 80rpx;
}

.template-name-overlay {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  text-align: center;
}

.template-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  display: block;
}

.template-desc {
  font-size: 22rpx;
  color: var(--text-light);
}

/* 小贴士 */
.tips-card {
  background: linear-gradient(135deg, #e0f7fa, #f3e5f5);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.tips-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
}

.tips-text {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}
