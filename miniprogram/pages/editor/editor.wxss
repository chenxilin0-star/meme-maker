/* 编辑器页面 */
.editor-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

.canvas-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}

.editor-canvas {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: var(--shadow);
}

/* 图层操作 */
.layer-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  background: var(--card-bg);
}

.action-btn {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: var(--bg);
  color: var(--text-secondary);
}

.action-btn.delete {
  background: #FFEBEE;
  color: #E53935;
}

/* 工具栏 */
.toolbar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: var(--card-bg);
  padding: 20rpx 0;
  border-top: 2rpx solid var(--border);
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.tool-icon {
  font-size: 48rpx;
}

.tool-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.tool-item.primary .tool-label {
  color: var(--primary);
  font-weight: 600;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  background: var(--card-bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
}

.modal-close {
  font-size: 36rpx;
  color: var(--text-light);
  padding: 8rpx;
}

.text-input {
  width: 100%;
  min-height: 120rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.picker-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.color-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.color-item {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.tool-item.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.tool-item:active {
  opacity: 0.8;
}

.size-picker {
  margin-bottom: 24rpx;
}

/* 贴纸弹窗 */
.sticker-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.sticker-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: var(--bg);
  border-radius: 16rpx;
}

.sticker-img {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 8rpx;
}

.sticker-name {
  font-size: 22rpx;
  color: var(--text-light);
}

/* 背景弹窗 */
.bg-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
}

.bg-item {
  aspect-ratio: 1;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
}

.bg-item.active {
  border-color: var(--primary);
}
