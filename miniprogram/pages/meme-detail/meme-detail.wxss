.page {
  min-height: 100vh;
  background: #f5f6fa;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #4a90d9;
  font-size: 28rpx;
}

.back-icon {
  font-size: 32rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.share-btn {
  padding: 8rpx 24rpx;
  background: #4a90d9;
  color: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.preview-area {
  display: flex;
  justify-content: center;
  padding: 40rpx 32rpx;
}

.meme-preview {
  max-width: 100%;
  max-height: 600rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
  background: #ffffff;
}

.action-bar {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx;
  background: #ffffff;
  margin: 0 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 32rpx;
}

.action-icon {
  font-size: 48rpx;
}

.action-label {
  font-size: 24rpx;
  color: #666;
}

.recommend-area {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #ffffff;
}

.recommend-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 20rpx;
}

.recommend-scroll {
  white-space: nowrap;
}

.recommend-list {
  display: flex;
  gap: 16rpx;
}

.recommend-card {
  flex-shrink: 0;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.recommend-img {
  width: 100%;
  height: 100%;
  background: #f0f0f5;
}
