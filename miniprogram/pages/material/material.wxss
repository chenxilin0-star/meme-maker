/* 素材页面 */

.category-scroll {
  margin-bottom: 24rpx;
}

.category-list {
  display: flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.category-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  background: var(--card-bg);
  white-space: nowrap;
  box-shadow: var(--shadow);
}

.category-item.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.category-icon {
  font-size: 32rpx;
}

/* 模板 */
.template-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: var(--shadow);
}

.template-preview {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  position: relative;
}

.template-preview-img {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  background: #f0f0f5;
}

.template-name {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
}

.template-tag {
  font-size: 22rpx;
  color: var(--text-light);
}

/* 贴纸 */
.sticker-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.sticker-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow);
}

.sticker-img {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 12rpx;
}

.sticker-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 背景 */
.bg-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.bg-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 16rpx;
  box-shadow: var(--shadow);
}

.bg-preview {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid var(--border);
}

.bg-name {
  font-size: 26rpx;
  text-align: center;
  color: var(--text-secondary);
}

/* 文案 */
.text-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.text-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow);
}

.text-content {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.text-category {
  font-size: 22rpx;
  color: var(--text-light);
  background: var(--bg);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}
