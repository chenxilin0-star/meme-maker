.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 120rpx;
}

.header {
  padding: 40rpx 32rpx 20rpx;
  background: #ffffff;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 16rpx 32rpx 20rpx;
  position: relative;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f0f0f5;
  border-radius: 36rpx;
  padding: 0 60rpx 0 28rpx;
  font-size: 28rpx;
  color: #333;
}

.search-icon {
  position: absolute;
  right: 52rpx;
  font-size: 28rpx;
}

.category-scroll {
  background: #ffffff;
  padding: 0 24rpx 20rpx;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
}

.category-item {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #f0f0f5;
  transition: all 0.2s;
}

.category-item.active {
  background: #4a90d9;
  color: #fff;
  font-weight: 600;
}

.meme-scroll {
  padding: 24rpx;
  height: calc(100vh - 320rpx);
}

.meme-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.meme-card {
  width: calc((100% - 32rpx) / 3);
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.meme-img {
  width: 100%;
  height: 220rpx;
  background: #f0f0f5;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.load-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #999;
}

.toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.tool-icon {
  font-size: 40rpx;
}

.tool-label {
  font-size: 22rpx;
  color: #666;
}
