.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 40rpx;
}

.header {
  padding: 40rpx 32rpx 24rpx;
  background: #ffffff;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 16rpx 32rpx 24rpx;
  position: relative;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f0f0f5;
  border-radius: 36rpx;
  padding: 0 60rpx 0 28rpx;
  font-size: 28rpx;
  color: #333;
}

.search-icon {
  position: absolute;
  right: 52rpx;
  font-size: 28rpx;
}

.category-scroll {
  background: #ffffff;
  padding: 0 24rpx 20rpx;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
}

.category-item {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #f0f0f5;
  transition: all 0.2s;
}

.category-item.active {
  background: #4a90d9;
  color: #fff;
  font-weight: 600;
}

.template-scroll {
  padding: 24rpx;
}

.template-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.template-card {
  width: calc(50% - 10rpx);
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
}

.template-img {
  width: 100%;
  height: 320rpx;
  background: #f0f0f5;
}

.template-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: rgba(0,0,0,0.35);
}

.template-name {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.template-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: #ff6b6b;
}

.template-text-preview {
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  background: #fafafa;
}

.free-create {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 32rpx;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.free-icon {
  font-size: 40rpx;
}

.free-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.free-desc {
  font-size: 24rpx;
  color: #999;
  margin-left: auto;
}
