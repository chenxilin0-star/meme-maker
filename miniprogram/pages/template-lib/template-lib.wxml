<!-- 表情包大全首页 -->
<view class="page">
  <!-- 顶部标题栏 -->
  <view class="header">
    <text class="title">表情包大全</text>
    <text class="subtitle">搜索、浏览、分享你想要的表情</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input 
      class="search-input" 
      placeholder="搜索表情包..." 
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
    <text class="search-icon">🔍</text>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x>
    <view class="category-list">
      <view 
        class="category-item {{activeCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="onCategoryTap"
        data-id="{{item.id}}"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <!-- 表情包网格 -->
  <scroll-view 
    class="meme-scroll" 
    scroll-y 
    lower-threshold="100"
    bindscrolltolower="onLoadMore"
  >
    <view class="meme-grid" wx:if="{{memes.length > 0}}">
      <view 
        class="meme-card"
        wx:for="{{memes}}"
        wx:key="id"
        bindtap="onMemeTap"
        data-item="{{item}}"
      >
        <image class="meme-img" src="{{item.src}}" mode="aspectFill" lazy-load/>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{memes.length === 0 && !loading}}">
      <text class="empty-icon">🔍</text>
      <text class="empty-text">没找到相关表情包</text>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:if="{{!hasMore && memes.length > 0}}">
      <text>已加载全部</text>
    </view>
  </scroll-view>

  <!-- 底部工具栏 -->
  <view class="toolbar">
    <view class="tool-item" bindtap="onCustomMeme">
      <text class="tool-icon">✏️</text>
      <text class="tool-label">自定义表情</text>
    </view>
    <view class="tool-item" bindtap="onFreeCreate">
      <text class="tool-icon">🎨</text>
      <text class="tool-label">自由创作</text>
    </view>
  </view>
</view>
